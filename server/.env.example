PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://valeria:CHANGE_ME@localhost:5432/valeria?schema=public
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRES_IN=1h
SENSOR_INTERVAL_MS=5000
SENSOR_INPUT_MODE=direct
SENSOR_STALE_AFTER_MS=60000
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=valeria_backend
MQTT_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_MQTT_PASSWORD
MQTT_CLIENT_ID=valeria-backend
SENSOR_TEMPERATURE_MIN=-10
SENSOR_TEMPERATURE_MAX=60
SENSOR_HUMIDITY_MIN=0
SENSOR_HUMIDITY_MAX=100
SENSOR_SOIL_MOISTURE_MIN=0
SENSOR_SOIL_MOISTURE_MAX=100
SENSOR_LIGHT_INTENSITY_MIN=0
SENSOR_LIGHT_INTENSITY_MAX=100000
SEED_USER_EMAIL=grower@example.test
SEED_USER_PASSWORD=SET_A_LOCAL_DEVELOPMENT_PASSWORD
SEED_SECOND_USER_EMAIL=second-grower@example.test
SEED_SECOND_USER_PASSWORD=SET_ANOTHER_LOCAL_DEVELOPMENT_PASSWORD
